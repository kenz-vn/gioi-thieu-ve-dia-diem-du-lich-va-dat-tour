@model TravelWeb.Models.DatLich
@{
    ViewData["Title"] = "Xử Lý Đơn Đặt Tour #" + Model.MaDatLich;
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold text-dark mb-1">
                    <i class="bi bi-file-earmark-text"></i> Đơn Đặt Tour: <span class="text-primary">#@Model.MaDatLich</span>
                </h3>
                <span class="badge bg-warning text-dark">Task DL-19: Màn hình nhân viên xử lý đơn (Kiên)</span>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại danh sách đơn</a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row g-4">
            <!-- CỘT TRÁI: THÔNG TIN CHI TIẾT ĐƠN HÀNG -->
            <div class="col-md-7">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light fw-bold py-3">
                        <i class="bi bi-info-circle"></i> Thông Tin Khách Hàng & Đơn Đặt
                    </div>
                    <div class="card-body">
                        <table class="table table-borderless mb-0">
                            <tr>
                                <td class="text-muted" style="width: 160px;">Mã Đặt Lịch:</td>
                                <td><strong class="text-primary fs-5">@Model.MaDatLich</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Mã Tra Cứu:</td>
                                <td><span class="badge bg-secondary">@Model.MaTraCuu</span></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Họ Tên Khách:</td>
                                <td><strong class="text-dark">@Model.HoTen</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Số Điện Thoại:</td>
                                <td><a href="tel:@Model.SoDienthoai" class="text-decoration-none"><i class="bi bi-telephone"></i> @Model.SoDienthoai</a></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Email:</td>
                                <td><a href="mailto:@Model.Email" class="text-decoration-none"><i class="bi bi-envelope"></i> @Model.Email</a></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Thời Gian Tạo Đơn:</td>
                                <td>@(Model.ThoiGianTao?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Trạng Thái Hiện Tại:</td>
                                <td>
                                    @if (Model.TrangThaiDat == "CHO_XAC_NHAN")
                                    {
                                        <span class="badge bg-warning text-dark fs-6"><i class="bi bi-hourglass-split"></i> Chờ xác nhận</span>
                                    }
                                    else if (Model.TrangThaiDat == "DA_XAC_NHAN")
                                    {
                                        <span class="badge bg-success fs-6"><i class="bi bi-check-circle"></i> Đã xác nhận</span>
                                    }
                                    else if (Model.TrangThaiDat == "TU_CHOI")
                                    {
                                        <span class="badge bg-danger fs-6"><i class="bi bi-x-circle"></i> Bị từ chối</span>
                                    }
                                    else if (Model.TrangThaiDat == "HOAN_THANH")
                                    {
                                        <span class="badge bg-primary fs-6"><i class="bi bi-flag"></i> Hoàn thành</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary fs-6">@Model.TrangThaiDat</span>
                                    }
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- THÔNG TIN TOUR ĐĂNG KÝ -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light fw-bold py-3">
                        <i class="bi bi-compass"></i> Dịch Vụ / Tour Đăng Ký
                    </div>
                    <div class="card-body">
                        @if (Model.DichVu != null)
                        {
                            <div class="d-flex align-items-center mb-3">
                                @if (!string.IsNullOrEmpty(Model.DichVu.HinhAnhPhong))
                                {
                                    <img src="~/images/@Model.DichVu.HinhAnhPhong" class="rounded me-3 shadow-sm" style="width: 90px; height: 65px; object-fit: cover;" onerror="this.src='/images/dalat.webp';" />
                                }
                                <div>
                                    <h6 class="fw-bold mb-1">@Model.DichVu.TenDichVu</h6>
                                    <div class="small text-muted"><i class="bi bi-geo-alt"></i> @(Model.DichVu.DiaDiem?.TenDiaDiem ?? "")</div>
                                    <div class="small text-success">
                                        <i class="bi bi-people"></i> Số chỗ tour còn nhận: <strong>@Model.DichVu.SoChoConLai</strong> / @Model.DichVu.SoChoToiDa chỗ
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="p-3 bg-light rounded">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Ngày khởi hành / tham quan:</span>
                                <strong>@Model.NgayThamQuan.ToString("dd/MM/yyyy")</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Số lượng khách:</span>
                                <strong>@Model.SoLuongKhach người</strong>
                            </div>
                            <div class="d-flex justify-content-between pt-2 border-top">
                                <span class="fs-6">Số tiền cọc cần thu:</span>
                                <strong class="fs-5 text-danger">@Model.SoTienCoc.ToString("N0") VNĐ</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: KHU VỰC THAO TÁC CỦA NHÂN VIÊN (DL-19) -->
            <div class="col-md-5">
                <!-- NHẬT KÝ XỬ LÝ (AUDIT LOG CỦA NHÂN VIÊN) -->
                <div class="card shadow-sm border-0 mb-4 border-start border-primary border-4">
                    <div class="card-header bg-white fw-bold py-3">
                        <i class="bi bi-person-badge"></i> Lịch Sử Xử Lý (Ghi nhận thao tác)
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.NguoiXuLy))
                        {
                            <div class="mb-2">
                                <span class="text-muted small">Nhân viên xử lý:</span>
                                <div class="fw-bold text-dark"><i class="bi bi-person-check-fill text-primary"></i> @Model.NguoiXuLy</div>
                            </div>
                            <div class="mb-2">
                                <span class="text-muted small">Thời điểm xử lý:</span>
                                <div class="small text-secondary"><i class="bi bi-clock"></i> @Model.ThoiGianXuLy?.ToString("dd/MM/yyyy HH:mm:ss")</div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.LyDoTuChoi))
                            {
                                <div class="alert alert-danger py-2 mt-2">
                                    <strong class="d-block"><i class="bi bi-x-circle"></i> Lý do từ chối:</strong>
                                    <span>@Model.LyDoTuChoi</span>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.GhiChuXuLy))
                            {
                                <div class="bg-light p-2 rounded small mt-2">
                                    <strong class="text-muted d-block">Ghi chú nội bộ:</strong>
                                    <span>@Model.GhiChuXuLy</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-3 text-muted">
                                <i class="bi bi-clock-history fs-3 d-block mb-1"></i>
                                Đơn chưa được nhân viên nào tiếp nhận xử lý.
                            </div>
                        }
                    </div>
                </div>

                <!-- FORM HÀNH ĐỘNG CỦA NHÂN VIÊN -->
                <div class="card shadow-sm border-0 border-start border-warning border-4">
                    <div class="card-header bg-white fw-bold py-3">
                        <i class="bi bi-gear-fill"></i> Thao Tác Cập Nhật Trạng Thái Đơn
                    </div>
                    <div class="card-body">
                        @if (Model.TrangThaiDat == "CHO_XAC_NHAN")
                        {
                            <!-- HÀNH ĐỘNG 1: XÁC NHẬN ĐƠN (DL-19) -->
                            <form asp-action="XacNhanDon" method="post" class="mb-3">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Ghi chú xác nhận (tùy chọn):</label>
                                    <input type="text" name="ghiChu" class="form-control form-control-sm" placeholder="Ví dụ: Đã gọi điện chốt lịch với khách..." />
                                </div>
                                <button type="submit" class="btn btn-success w-100 fw-bold" onclick="return confirm('Xác nhận duyệt đơn đặt tour này? (Hệ thống sẽ tự động trừ @Model.SoLuongKhach chỗ của tour)');">
                                    <i class="bi bi-check-circle-fill"></i> XÁC NHẬN ĐƠN NÀY
                                </button>
                            </form>

                            <hr />

                            <!-- HÀNH ĐỘNG 2: TỪ CHỐI ĐƠN (TIÊU CHÍ DL-19: BẮT BUỘC LÝ DO) -->
                            <form asp-action="TuChoiDon" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="mb-2">
                                    <label class="form-label small fw-bold text-danger">Lý do từ chối (Bắt buộc theo tiêu chí nghiệm thu):</label>
                                    <textarea name="lyDoTuChoi" class="form-control form-control-sm border-danger" rows="3" required placeholder="Nhập rõ lý do từ chối (Ví dụ: Hết chỗ ngày tham quan, thời tiết xấu, thông tin liên hệ không chính xác...)"></textarea>
                                </div>
                                <div class="mb-2">
                                    <input type="text" name="ghiChu" class="form-control form-control-sm" placeholder="Ghi chú nội bộ cho nhân viên..." />
                                </div>
                                <button type="submit" class="btn btn-outline-danger w-100 fw-bold">
                                    <i class="bi bi-x-circle-fill"></i> TỪ CHỐI ĐƠN
                                </button>
                            </form>
                        }
                        else if (Model.TrangThaiDat == "DA_XAC_NHAN")
                        {
                            <div class="alert alert-success py-2 small mb-3">
                                <i class="bi bi-check-all"></i> Đơn đã được xác nhận thành công. Bạn có thể cập nhật kết thúc tour khi khách hoàn thành chuyến đi.
                            </div>

                            <form asp-action="CapNhatTrangThai" method="post" class="mb-2">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="trangThaiMoi" value="HOAN_THANH" />
                                <button type="submit" class="btn btn-primary w-100 fw-bold" onclick="return confirm('Đánh dấu đơn này đã hoàn thành tour?');">
                                    <i class="bi bi-flag-fill"></i> ĐÁNH DẤU ĐÃ HOÀN THÀNH TOUR
                                </button>
                            </form>

                            <form asp-action="CapNhatTrangThai" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="trangThaiMoi" value="DA_HUY" />
                                <div class="mb-2">
                                    <input type="text" name="ghiChu" class="form-control form-control-sm" placeholder="Lý do hủy tour..." />
                                </div>
                                <button type="submit" class="btn btn-outline-secondary w-100 btn-sm" onclick="return confirm('Hủy đơn đặt tour này? (Hệ thống sẽ hoàn trả lại @Model.SoLuongKhach chỗ cho tour)');">
                                    <i class="bi bi-slash-circle"></i> Hủy Đơn (Hoàn lại chỗ)
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-secondary py-3 text-center small mb-0">
                                Đơn đang ở trạng thái <strong>@Model.TrangThaiDat</strong>, không cần thực hiện thêm thao tác.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
