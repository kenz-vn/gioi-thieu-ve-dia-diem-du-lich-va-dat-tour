@model TravelWeb.Models.DichVu
@{
    ViewData["Title"] = "Đặt Tour - " + Model.TenDichVu;
    decimal giaNguoiLon = (Model.GiaKhuyenMai.HasValue && Model.GiaKhuyenMai.Value > 0) ? Model.GiaKhuyenMai.Value : Model.GiaTien;
    decimal giaTreEm = (Model.GiaTreEm.HasValue && Model.GiaTreEm.Value > 0) ? Model.GiaTreEm.Value : Math.Round(giaNguoiLon * 0.6m, 0);
    string todayStr = DateTime.Today.ToString("yyyy-MM-dd");
    string checkOutStr = DateTime.Today.AddDays(2).ToString("yyyy-MM-dd");
}

<div class="container mt-4 mb-5">
    <!-- TIÊU ĐỀ TRANG -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Tour" asp-action="Index">Tour du lịch</a></li>
            <li class="breadcrumb-item active" aria-current="page">Đặt tour</li>
        </ol>
    </nav>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- CỘT 1: THÔNG TIN CHI TIẾT TOUR & BẢNG GIÁ VÉ -->
        <div class="col-lg-5 mb-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                @{
                    string tourImg = string.IsNullOrEmpty(Model.HinhAnhPhong) 
                        ? "/images/dalat.jpg" 
                        : (Model.HinhAnhPhong.StartsWith("http://") || Model.HinhAnhPhong.StartsWith("https://") 
                            ? Model.HinhAnhPhong 
                            : (Model.HinhAnhPhong.StartsWith("/") ? Model.HinhAnhPhong : "/images/" + Model.HinhAnhPhong));
                }
                <img src="@tourImg" class="card-img-top rounded-top" alt="Ảnh tour" style="height: 250px; object-fit: cover;" onerror="this.src='/images/halong.jpg';">
                
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-primary px-3 py-2"><i class="bi bi-clock"></i> @(Model.ThoiLuong ?? "3 ngày 2 đêm")</span>
                        @if (Model.SoChoConLai <= 0 || Model.TrangThaiTour == "HET_CHO")
                        {
                            <span class="badge bg-danger px-3 py-2"><i class="bi bi-x-circle"></i> ĐÃ HẾT CHỖ</span>
                        }
                        else
                        {
                            <span class="badge bg-success px-3 py-2"><i class="bi bi-check-circle"></i> Còn @Model.SoChoConLai chỗ</span>
                        }
                    </div>

                    <h4 class="card-title text-primary fw-bold">@Model.TenDichVu</h4>
                    <p class="text-muted small mb-2"><i class="bi bi-geo-alt-fill text-danger"></i> <strong>Địa điểm:</strong> @(Model.DiaDiem?.TenDiaDiem ?? "Việt Nam") - @(Model.DiaDiem?.DiaChi ?? "")</p>
                    
                    @if (!string.IsNullOrEmpty(Model.DiemBatDau) || !string.IsNullOrEmpty(Model.DiemKetThuc))
                    {
                        <div class="p-2 bg-light rounded small mb-3">
                            <div><i class="bi bi-pin-map-fill text-success"></i> <strong>Khởi hành:</strong> @(Model.DiemBatDau ?? "Hà Nội / TP.HCM")</div>
                            <div><i class="bi bi-flag-fill text-danger"></i> <strong>Điểm đến:</strong> @(Model.DiemKetThuc ?? Model.DiaDiem?.TenDiaDiem)</div>
                        </div>
                    }

                    <div class="card bg-light border-0 p-3 mb-3">
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-2"><i class="bi bi-tags-fill text-warning"></i> BẢNG GIÁ VÉ TOUR</h6>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span><i class="bi bi-person-fill text-primary"></i> <strong>Vé Người lớn:</strong></span>
                            <span class="fw-bold text-danger fs-5">@giaNguoiLon.ToString("N0") VNĐ</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span><i class="bi bi-person-heart text-success"></i> <strong>Vé Trẻ em (&lt;12t):</strong></span>
                            <span class="fw-bold text-success fs-5">@giaTreEm.ToString("N0") VNĐ</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small text-muted pt-2 border-top">
                            <span>Tỷ lệ đặt cọc giữ chỗ:</span>
                            <span class="badge bg-info text-dark">@Model.TyLeCoc%</span>
                        </div>
                    </div>

                    <div class="alert alert-warning py-2 small mb-0">
                        <i class="bi bi-info-circle-fill me-1"></i> Quý khách chỉ cần thanh toán trước tiền cọc (<strong>@Model.TyLeCoc%</strong>) để bảo lưu chỗ. Số tiền còn lại sẽ thanh toán khi xuất phát tour.
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT 2: FORM NHẬP THÔNG TIN ĐẶT TOUR -->
        <div class="col-lg-7 mb-4">
            <div class="card shadow-sm border-0 p-4">
                <div class="d-flex align-items-center border-bottom pb-3 mb-3">
                    <div class="bg-success text-white rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                        <i class="bi bi-ticket-perforated fs-4"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 text-success fw-bold">Phiếu Đăng Ký Đặt Tour</h4>
                        <small class="text-muted">Vui lòng điền thông tin chính xác để nhân viên liên hệ xác nhận</small>
                    </div>
                </div>

                @if (Model.SoChoConLai <= 0 || Model.TrangThaiTour == "HET_CHO")
                {
                    <div class="alert alert-danger text-center py-4 my-3">
                        <i class="bi bi-slash-circle-fill fs-1 text-danger d-block mb-2"></i>
                        <h4 class="fw-bold">RẤT TIẾC, TOUR HIỆN ĐÃ HẾT CHỖ!</h4>
                        <p class="mb-3">Hiện tại tour này không còn chỗ trống. Quý khách vui lòng tham khảo các tour khác hoặc liên hệ hotline để được thông báo khi có chỗ trống.</p>
                        <a asp-controller="Tour" asp-action="Index" class="btn btn-outline-danger">Xem danh sách tour khác</a>
                    </div>
                }
                else
                {
                    <form id="formDatTour" asp-controller="Booking" asp-action="XacNhanDatTour" method="post">
                        <!-- ID tour ngầm -->
                        <input type="hidden" name="maDichVu" value="@Model.MaDichVu" />

                        <!-- PHẦN 1: THÔNG TIN KHÁCH HÀNG -->
                        <h6 class="fw-bold text-secondary text-uppercase mb-3"><i class="bi bi-person-lines-fill"></i> 1. Thông Tin Người Đại Diện Đặt</h6>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Họ và tên người đặt: <span class="text-danger">*</span></label>
                            <input type="text" name="hoTen" class="form-control" value="@ViewBag.HoTen" placeholder="Nhập họ và tên đầy đủ..." required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Số điện thoại liên hệ: <span class="text-danger">*</span></label>
                                <input type="tel" name="soDienthoai" class="form-control" value="@ViewBag.SoDienthoai" placeholder="Ví dụ: 0912345678" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Email nhận xác nhận & vé: <span class="text-danger">*</span></label>
                                <input type="email" name="email" class="form-control" value="@ViewBag.Email" placeholder="example@gmail.com" required />
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- PHẦN 2: SỐ LƯỢNG VÉ NGƯỜI LỚN & TRẺ EM + KIỂM TRA CHỖ TRỐNG -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-secondary text-uppercase mb-0"><i class="bi bi-people-fill"></i> 2. Số Lượng Vé & Hành Khách</h6>
                            <span class="badge bg-success-subtle text-success border border-success">
                                <i class="bi bi-shield-check"></i> Chỗ trống hiện còn: <strong id="soChoConLaiDisplay">@Model.SoChoConLai</strong> chỗ
                            </span>
                        </div>

                        <div class="row g-3 p-3 bg-light rounded mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">
                                    <i class="bi bi-person-fill text-primary"></i> Người lớn (Từ 12 tuổi):
                                </label>
                                <div class="input-group">
                                    <input type="number" id="soLuongNguoiLon" name="soLuongNguoiLon" class="form-control form-control-lg text-center fw-bold" value="1" min="1" max="@Model.SoChoConLai" oninput="capNhatTongThe()" required />
                                    <span class="input-group-text">khách</span>
                                </div>
                                <div class="small text-muted mt-1">Đơn giá: @giaNguoiLon.ToString("N0") VNĐ</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">
                                    <i class="bi bi-person-heart text-success"></i> Trẻ em (Dưới 12 tuổi):
                                </label>
                                <div class="input-group">
                                    <input type="number" id="soLuongTreEm" name="soLuongTreEm" class="form-control form-control-lg text-center fw-bold" value="0" min="0" max="@Model.SoChoConLai" oninput="capNhatTongThe()" />
                                    <span class="input-group-text">trẻ</span>
                                </div>
                                <div class="small text-muted mt-1">Đơn giá: @giaTreEm.ToString("N0") VNĐ</div>
                            </div>

                            <div class="col-12">
                                <div class="p-2 border rounded bg-white d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-muted">Tổng số lượng hành khách:</span>
                                    <span class="badge bg-primary fs-6 px-3 py-2" id="txtTongHanhKhach">1 người (1 Người lớn, 0 Trẻ em)</span>
                                </div>
                            </div>
                        </div>

                        <!-- CẢNH BÁO NẾU VƯỢT QUÁ CHỖ TRỐNG CÒN LẠI -->
                        <div id="alertVuotQuaChoTrong" class="alert alert-danger d-none shadow-sm animate__animated animate__shakeX">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-exclamation-octagon-fill fs-2 me-3 text-danger"></i>
                                <div>
                                    <h6 class="fw-bold mb-1">CẢNH BÁO: VƯỢT QUÁ SỐ CHỖ CÒN LẠI!</h6>
                                    <div id="txtAlertNoiDung">Tour chỉ còn @Model.SoChoConLai chỗ trống. Vui lòng giảm số lượng khách để tiến hành đặt tour chính xác.</div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- PHẦN 3: THỜI GIAN CHECK-IN & CHECK-OUT (MẶC ĐỊNH LÀ HÔM NAY) -->
                        <h6 class="fw-bold text-secondary text-uppercase mb-3"><i class="bi bi-calendar2-range-fill"></i> 3. Thời Gian Khởi Hành & Check-in / Check-out</h6>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-calendar-event text-primary"></i> Ngày khởi hành / Check-in: <span class="text-danger">*</span>
                                </label>
                                <input type="date" id="ngayThamQuan" name="ngayThamQuan" class="form-control" value="@todayStr" min="@todayStr" onchange="dongBoCheckIn()" required />
                                <div class="form-text small">Mặc định là ngày hôm nay (@todayStr). Quý khách có thể đổi ngày theo ý muốn.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-calendar-check text-success"></i> Ngày kết thúc / Check-out:
                                </label>
                                <input type="date" id="ngayCheckOut" name="ngayCheckOut" class="form-control" value="@checkOutStr" min="@todayStr" onchange="capNhatTongThe()" />
                                <div class="form-text small">Thời gian dự kiến trả phòng (12:00 trưa).</div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- PHẦN 4: CHỌN KHÁCH SẠN, LOẠI PHÒNG & THÔNG BÁO SỐ PHÒNG ĐẶT -->
                        <h6 class="fw-bold text-secondary text-uppercase mb-3"><i class="bi bi-building"></i> 4. Lựa Chọn Khách Sạn & Loại Phòng Lưu Trú</h6>

                        <div class="p-3 border rounded bg-light mb-3">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Tên khách sạn / Nơi ở:</label>
                                    <select name="tenKhachSan" id="tenKhachSan" class="form-select" onchange="capNhatThongBaoPhong()">
                                        <option value="Khách sạn 4 sao liên kết tour (Tiêu chuẩn cao cấp)" selected>Khách sạn 4 sao liên kết tour (Tiêu chuẩn)</option>
                                        <option value="Khách sạn 5 sao cao cấp ven biển / trung tâm">Khách sạn 5 sao cao cấp (Ven biển/Trung tâm)</option>
                                        <option value="Khách sạn 3 sao tiện nghi, trung tâm phố cổ">Khách sạn 3 sao tiện nghi phố cổ</option>
                                        <option value="Resort & Spa nghỉ dưỡng sinh thái">Resort & Spa sinh thái</option>
                                        <option value="Homestay gia đình ấm cúng / View đẹp">Homestay gia đình ấm cúng view đẹp</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Loại phòng & Giường: <span class="text-danger">*</span></label>
                                    <select name="loaiPhong" id="loaiPhong" class="form-select" onchange="thayDoiLoaiPhong()">
                                        <option value="Phòng 2 người (Giường đôi)" data-capacity="2" selected>Phòng 2 người (Giường đôi - Double Bed)</option>
                                        <option value="Phòng 2 người (Giường chung)" data-capacity="2">Phòng 2 người (Giường chung - Twin Beds)</option>
                                        <option value="Phòng 4 người (Giường đôi)" data-capacity="4">Phòng 4 người (2 Giường đôi lớn)</option>
                                        <option value="Phòng 4 người (Giường chung)" data-capacity="4">Phòng 4 người (4 Giường đơn chung)</option>
                                        <option value="Phòng ghép (Dorm / Ở ghép đoàn)" data-capacity="1">Phòng ghép (Dorm / Giường ghép đoàn)</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Số lượng phòng quý khách đặt: <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input type="number" id="soLuongPhong" name="soLuongPhong" class="form-control text-center fw-bold" value="1" min="1" max="20" oninput="capNhatThongBaoPhong()" required />
                                        <span class="input-group-text">phòng</span>
                                    </div>
                                    <div class="form-text small" id="txtGoiYSophong">Đề xuất tự động theo số khách.</div>
                                </div>

                                <div class="col-md-6 d-flex align-items-center">
                                    <div class="w-100">
                                        <button type="button" class="btn btn-outline-primary btn-sm w-100 mt-md-3" onclick="tuDongTinhPhong()">
                                            <i class="bi bi-calculator"></i> Tự động tính số phòng tối ưu
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- KHUNG THÔNG BÁO SỐ PHÒNG KHÁCH HÀNG ĐẶT Ở KHÁCH SẠN ĐÓ -->
                            <div class="alert alert-info border-info mt-3 mb-0" id="boxThongBaoPhong">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-info-circle-fill fs-4 text-info me-2 mt-1"></i>
                                    <div>
                                        <strong class="text-dark">Thông báo xác nhận phòng nghỉ:</strong>
                                        <p class="mb-0 text-primary fw-bold" id="txtThongBaoPhongChiTiet">
                                            Quý khách đang đặt <span class="badge bg-primary fs-6">1 phòng</span> [Phòng 2 người (Giường đôi)] tại [Khách sạn 4 sao liên kết tour (Tiêu chuẩn)] cho đoàn 1 khách.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- PHẦN 5: BẢNG TÍNH TIỀN VÀ TIỀN CỌC TỰ ĐỘNG -->
                        <div class="card border-success bg-white shadow-sm mb-4">
                            <div class="card-header bg-success text-white fw-bold">
                                <i class="bi bi-receipt"></i> BẢNG TỔNG KẾT CHI PHÍ ĐẶT TOUR
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Vé người lớn (<span id="lblNguoiLonCount">1</span> khách x @giaNguoiLon.ToString("N0") VNĐ):</span>
                                    <span id="txtTienNguoiLon" class="fw-bold">@giaNguoiLon.ToString("N0") VNĐ</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Vé trẻ em (<span id="lblTreEmCount">0</span> trẻ x @giaTreEm.ToString("N0") VNĐ):</span>
                                    <span id="txtTienTreEm" class="fw-bold text-success">0 VNĐ</span>
                                </div>
                                <hr />
                                <div class="d-flex justify-content-between mb-2 fs-5">
                                    <span class="fw-bold text-dark">Tổng chi phí tour:</span>
                                    <span id="txtTongTienTour" class="fw-bold text-danger">@giaNguoiLon.ToString("N0") VNĐ</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center p-2 rounded bg-light border">
                                    <div>
                                        <span class="fw-bold text-success fs-5">Số tiền cọc cần thanh toán (@Model.TyLeCoc%):</span>
                                        <div class="small text-muted">Thanh toán ngay để giữ chỗ chính thức</div>
                                    </div>
                                    <span id="txtSoTienCoc" class="fw-bold text-danger fs-4">
                                        @((Math.Round(giaNguoiLon * (Model.TyLeCoc / 100m), 0)).ToString("N0")) VNĐ
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between mt-2 small text-muted">
                                    <span>Số tiền còn lại thanh toán khi đi tour:</span>
                                    <span id="txtSoTienConLai" class="fw-bold">
                                        @((giaNguoiLon - Math.Round(giaNguoiLon * (Model.TyLeCoc / 100m), 0)).ToString("N0")) VNĐ
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- NÚT XÁC NHẬN ĐẶT TOUR -->
                        <div class="d-grid gap-2">
                            <button type="submit" id="btnSubmitDatTour" class="btn btn-success btn-lg fw-bold py-3 shadow">
                                <i class="bi bi-shield-lock-fill me-2"></i> Xác Nhận Đặt Tour & Thanh Toán Cọc
                            </button>
                            <a href="javascript:history.back()" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại
                            </a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<!-- SCRIPT XỬ LÝ TOÀN BỘ NGHIỆP VỤ TÍNH TIỀN, CẢNH BÁO CHỖ VÀ ĐẶT PHÒNG KHÁCH SẠN -->
<script>
    const giaNguoiLon = @giaNguoiLon;
    const giaTreEm = @giaTreEm;
    const tyLeCoc = @Model.TyLeCoc;
    const soChoConLai = @Model.SoChoConLai;

    function dongBoCheckIn() {
        const ngayIn = document.getElementById("ngayThamQuan").value;
        if (ngayIn) {
            const dateIn = new Date(ngayIn);
            dateIn.setDate(dateIn.getDate() + 2);
            const yyyy = dateIn.getFullYear();
            const mm = String(dateIn.getMonth() + 1).padStart(2, '0');
            const dd = String(dateIn.getDate()).padStart(2, '0');
            document.getElementById("ngayCheckOut").value = `${yyyy}-${mm}-${dd}`;
            document.getElementById("ngayCheckOut").min = ngayIn;
        }
        capNhatTongThe();
    }

    function thayDoiLoaiPhong() {
        tuDongTinhPhong();
        capNhatThongBaoPhong();
    }

    function tuDongTinhPhong() {
        const nguoiLon = parseInt(document.getElementById("soLuongNguoiLon").value) || 0;
        const treEm = parseInt(document.getElementById("soLuongTreEm").value) || 0;
        const tongKhach = Math.max(1, nguoiLon + treEm);

        const selectLoaiPhong = document.getElementById("loaiPhong");
        const capacity = parseInt(selectLoaiPhong.options[selectLoaiPhong.selectedIndex].getAttribute("data-capacity")) || 2;

        let soPhong = Math.ceil(tongKhach / capacity);
        if (soPhong < 1) soPhong = 1;
        document.getElementById("soLuongPhong").value = soPhong;
        capNhatThongBaoPhong();
    }

    function capNhatThongBaoPhong() {
        const ksSelect = document.getElementById("tenKhachSan");
        const tenKS = ksSelect.options[ksSelect.selectedIndex].text;
        const lpSelect = document.getElementById("loaiPhong");
        const tenLP = lpSelect.options[lpSelect.selectedIndex].text;
        const soPhong = document.getElementById("soLuongPhong").value || 1;

        const nguoiLon = parseInt(document.getElementById("soLuongNguoiLon").value) || 0;
        const treEm = parseInt(document.getElementById("soLuongTreEm").value) || 0;
        const tongKhach = nguoiLon + treEm;

        const txt = `Quý khách đang chọn đặt <span class="badge bg-primary fs-6">${soPhong} phòng</span> (${tenLP}) tại [${tenKS}] cho đoàn ${tongKhach} khách.`;
        document.getElementById("txtThongBaoPhongChiTiet").innerHTML = txt;
    }

    function capNhatTongThe() {
        let nguoiLon = parseInt(document.getElementById("soLuongNguoiLon").value);
        if (isNaN(nguoiLon) || nguoiLon < 1) nguoiLon = 1;

        let treEm = parseInt(document.getElementById("soLuongTreEm").value);
        if (isNaN(treEm) || treEm < 0) treEm = 0;

        const tongKhach = nguoiLon + treEm;
        document.getElementById("txtTongHanhKhach").innerText = `${tongKhach} người (${nguoiLon} Người lớn, ${treEm} Trẻ em)`;
        document.getElementById("lblNguoiLonCount").innerText = nguoiLon;
        document.getElementById("lblTreEmCount").innerText = treEm;

        // KIỂM TRA SỐ CHỖ CÒN LẠI VÀ HIỂN THỊ CẢNH BÁO NẾU VƯỢT QUÁ
        const alertBox = document.getElementById("alertVuotQuaChoTrong");
        const btnSubmit = document.getElementById("btnSubmitDatTour");

        if (tongKhach > soChoConLai) {
            alertBox.classList.remove("d-none");
            document.getElementById("txtAlertNoiDung").innerHTML = 
                `Quý khách đang chọn tổng cộng <strong>${tongKhach} khách</strong>, vượt quá số chỗ trống hiện còn của tour là <strong>${soChoConLai} chỗ</strong>! Vui lòng giảm số lượng để tiến hành đặt tour chính xác.`;
            btnSubmit.disabled = true;
            btnSubmit.classList.remove("btn-success");
            btnSubmit.classList.add("btn-secondary");
            btnSubmit.innerHTML = `<i class="bi bi-x-circle-fill me-2"></i> Không Đủ Chỗ Trống (Chỉ còn ${soChoConLai} chỗ)`;
        } else {
            alertBox.classList.add("d-none");
            btnSubmit.disabled = false;
            btnSubmit.classList.remove("btn-secondary");
            btnSubmit.classList.add("btn-success");
            btnSubmit.innerHTML = `<i class="bi bi-shield-lock-fill me-2"></i> Xác Nhận Đặt Tour & Thanh Toán Cọc`;
        }

        // TÍNH TOÁN TIỀN
        const tienNguoiLon = nguoiLon * giaNguoiLon;
        const tienTreEm = treEm * giaTreEm;
        const tongTien = tienNguoiLon + tienTreEm;
        const soTienCoc = Math.round(tongTien * (tyLeCoc / 100));
        const soTienConLai = tongTien - soTienCoc;

        document.getElementById("txtTienNguoiLon").innerText = tienNguoiLon.toLocaleString('vi-VN') + " VNĐ";
        document.getElementById("txtTienTreEm").innerText = tienTreEm.toLocaleString('vi-VN') + " VNĐ";
        document.getElementById("txtTongTienTour").innerText = tongTien.toLocaleString('vi-VN') + " VNĐ";
        document.getElementById("txtSoTienCoc").innerText = soTienCoc.toLocaleString('vi-VN') + " VNĐ";
        document.getElementById("txtSoTienConLai").innerText = soTienConLai.toLocaleString('vi-VN') + " VNĐ";

        capNhatThongBaoPhong();
    }

    // Khởi chạy khi load trang
    document.addEventListener("DOMContentLoaded", function() {
        capNhatTongThe();
        capNhatThongBaoPhong();
    });
</script>
