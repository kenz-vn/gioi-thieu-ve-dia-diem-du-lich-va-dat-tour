@{
    ViewData["Title"] = "Không Có Quyền Truy Cập";
    string currentRole = ViewBag.CurrentRole ?? "KHACH_HANG";
    string yeuCau = ViewBag.YeuCau ?? "ADMIN, NHAN_VIEN";
}

<div class="row justify-content-center my-5">
    <div class="col-md-7 text-center">
        <div class="card shadow border-0 p-5">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-slash" style="font-size: 5rem;"></i>
            </div>
            <h2 class="fw-bold text-danger">403 - Truy Cập Bị Từ Chối!</h2>
            <p class="text-muted mt-2">
                Hệ thống phân quyền đã bảo vệ route này. Bạn hiện đang ở vai trò: <strong class="text-dark">@currentRole</strong>.
            </p>
            <div class="alert alert-warning text-start my-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> <strong>Yêu cầu nghiệp vụ (DL-09, DL-13, DL-21):</strong><br />
                Chức năng này chỉ cho phép các tài khoản có vai trò: <span class="badge bg-danger">@yeuCau</span> thao tác.
                Người không có quyền không được sửa đổi dữ liệu!
            </div>
            
            <p class="text-secondary small">Để phục vụ đánh giá và nghiệm thu sprint, bạn có thể chuyển đổi nhanh vai trò bên dưới:</p>
            
            <div class="d-flex justify-content-center gap-2 mt-2">
                <form asp-controller="Admin" asp-action="SwitchRole" method="post" class="d-inline">
                    <input type="hidden" name="role" value="NHAN_VIEN" />
                    <input type="hidden" name="returnUrl" value="/Admin" />
                    <button type="submit" class="btn btn-warning text-dark fw-bold">
                        <i class="bi bi-person-gear"></i> Chuyển sang vai trò Nhân Viên (Bùi Trung Kiên)
                    </button>
                </form>

                <form asp-controller="Admin" asp-action="SwitchRole" method="post" class="d-inline">
                    <input type="hidden" name="role" value="ADMIN" />
                    <input type="hidden" name="returnUrl" value="/Admin" />
                    <button type="submit" class="btn btn-primary fw-bold">
                        <i class="bi bi-shield-lock"></i> Chuyển sang vai trò Admin
                    </button>
                </form>

                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-house"></i> Về trang chủ
                </a>
            </div>
        </div>
    </div>
</div>
