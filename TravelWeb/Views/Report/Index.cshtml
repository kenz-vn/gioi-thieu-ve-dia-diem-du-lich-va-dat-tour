@model IEnumerable<TravelWeb.Controllers.BaoCaoDoanhThuViewModel>

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold mb-0">📊 Báo Cáo Thống Kê Đặt Tour</h2>
        <!-- NÚT XUẤT CSV - UC-06 -->
        <a asp-action="XuatCSV" asp-route-tuNgay="@ViewBag.TuNgay" asp-route-denNgay="@ViewBag.DenNgay"
           class="btn btn-success fw-bold shadow-sm mt-2 mt-md-0">
            <i class="bi bi-file-earmark-spreadsheet-fill"></i> Xuất Báo Cáo CSV
        </a>
    </div>

    <!-- Form Lọc Theo Khoảng Thời Gian -->
    <div class="card p-3 mb-4 bg-light shadow-sm">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-bold">Từ ngày:</label>
                <input type="date" name="tuNgay" class="form-control" value="@ViewBag.TuNgay">
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Đến ngày:</label>
                <input type="date" name="denNgay" class="form-control" value="@ViewBag.DenNgay">
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100 fw-bold">Lọc Báo Cáo</button>
            </div>
        </form>
    </div>

        <!-- Thẻ Tổng Quan (Cards) -->
    <div class="row text-white mb-4">
        <div class="col-md-2 mb-2">
            <div class="card bg-secondary p-3 shadow-sm rounded text-center">
                <div class="small fw-bold">Tổng Đơn</div>
                <h4 class="fw-bold mb-0">@ViewBag.TongDonTatCa</h4>
            </div>
        </div>
        <div class="col-md-2 mb-2">
            <div class="card bg-warning text-dark p-3 shadow-sm rounded text-center">
                <div class="small fw-bold">Chờ Xác Nhận</div>
                <h4 class="fw-bold mb-0">@ViewBag.DonChoXacNhan</h4>
            </div>
        </div>
        <div class="col-md-2 mb-2">
            <div class="card bg-success p-3 shadow-sm rounded text-center">
                <div class="small fw-bold">Đã Xác Nhận</div>
                <h4 class="fw-bold mb-0">@ViewBag.DonDaXacNhan</h4>
            </div>
        </div>
        <div class="col-md-2 mb-2">
            <div class="card bg-danger p-3 shadow-sm rounded text-center">
                <div class="small fw-bold">Đã Hủy / Từ Chối</div>
                <h4 class="fw-bold mb-0">@((ViewBag.DonDaHuy ?? 0) + (ViewBag.DonTuChoi ?? 0))</h4>
            </div>
        </div>
        <div class="col-md-2 mb-2">
            <div class="card bg-info p-3 shadow-sm rounded text-center">
                <div class="small fw-bold">Tổng Số Khách</div>
                <h4 class="fw-bold mb-0">@ViewBag.TongKhach</h4>
            </div>
        </div>
        <div class="col-md-2 mb-2">
            <div class="card bg-primary p-3 shadow-sm rounded text-center">
                <div class="small fw-bold">Doanh Thu Cọc</div>
                <h5 class="fw-bold mb-0">@(((decimal)(ViewBag.TongDoanhThu ?? 0)).ToString("N0"))đ</h5>
            </div>
        </div>
    </div>

    <!-- BẢNG 1: TOP TOUR PHỔ BIẾN -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">🔥 Top Tour Phổ Biến Nhất (Theo lượt đặt)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-secondary">
                        <tr>
                            <th>Tên Tour / Dịch Vụ</th>
                            <th>Số Lượt Đặt</th>
                            <th>Tổng Số Khách</th>
                            <th>Doanh Thu Cọc Thu Được</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.TourPhoBienList != null && ((List<TravelWeb.Controllers.TourPhoBienViewModel>)ViewBag.TourPhoBienList).Any())
                        {
                            foreach (var tour in (List<TravelWeb.Controllers.TourPhoBienViewModel>)ViewBag.TourPhoBienList)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@tour.TenTour</td>
                                    <td><span class="badge bg-primary fs-6">@tour.SoLuotDat lượt</span></td>
                                    <td>@tour.TongKhach khách</td>
                                    <td class="text-success fw-bold">@tour.TongDoanhThuCoc.ToString("N0") VNĐ</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">Chưa có dữ liệu đặt tour trong khoảng thời gian này!</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- BẢNG 2: CHI TIẾT SỐ ĐƠN & DOANH THU THEO NGÀY -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">📈 Chi Tiết Số Đơn & Doanh Thu Tiền Cọc Theo Ngày</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead class="table-secondary">
                        <tr>
                            <th>Ngày Thống Kê</th>
                            <th>Số Lượng Đơn</th>
                            <th>Tổng Số Khách</th>
                            <th>Doanh Thu Tiền Cọc (VNĐ)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.NgayThongKe.ToString("dd/MM/yyyy")</td>
                                    <td>@item.TongSoDon đơn</td>
                                    <td>@item.TongSoKhach khách</td>
                                    <td class="fw-bold text-success">@item.TongDoanhThuCoc.ToString("N0") VNĐ</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">Không có dữ liệu báo cáo trong khoảng thời gian này!</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>