@model IEnumerable<TravelWeb.Models.DiaDiem>
@{
    ViewData["Title"] = "Quản Lý Địa Điểm Du Lịch (DL-09)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold text-primary mb-1"><i class="bi bi-geo-alt-fill"></i> Quản Lý Địa Điểm Du Lịch</h2>
        <span class="badge bg-primary">Sprint 1 / Task DL-09 (Kiên phụ trách)</span>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-bold">
        <i class="bi bi-plus-circle"></i> Thêm Địa Điểm Mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- BỘ LỌC VÀ TÌM KIẾM -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="tuKhoa" class="form-control" placeholder="Tìm theo tên địa điểm, địa chỉ..." value="@ViewBag.TuKhoa" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="maDanhMuc" class="form-select" asp-items="ViewBag.DanhMucs">
                    <option value="">-- Tất cả danh mục --</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-filter"></i> Lọc dữ liệu</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- BẢNG DANH SÁCH ĐỊA ĐIỂM -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 100px;">Hình Ảnh</th>
                    <th>Tên Địa Điểm</th>
                    <th>Danh Mục</th>
                    <th>Địa Chỉ & Hotline</th>
                    <th>Số Tour</th>
                    <th>Trạng Thái</th>
                    <th class="text-end" style="min-width: 180px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.HinhAnh))
                                {
                                    <img src="~/images/@item.HinhAnh" class="rounded shadow-sm" style="width: 80px; height: 60px; object-fit: cover;" alt="@item.TenDiaDiem" onerror="this.src='/images/dalat.webp';" />
                                }
                                else
                                {
                                    <div class="bg-light text-muted d-flex align-items-center justify-content-center rounded" style="width: 80px; height: 60px;">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.TenDiaDiem</div>
                                <div class="small text-muted text-truncate" style="max-width: 280px;" title="@item.NoiCanToi">
                                    <i class="bi bi-pin-map"></i> @(string.IsNullOrEmpty(item.NoiCanToi) ? "Chưa cập nhật điểm đến" : item.NoiCanToi)
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                    @(item.DanhMuc != null ? item.DanhMuc.TenDanhMuc : "Chưa phân loại")
                                </span>
                            </td>
                            <td>
                                <div class="small"><i class="bi bi-geo-alt"></i> @item.DiaChi</div>
                                <div class="small text-muted"><i class="bi bi-telephone"></i> @(item.Hotline ?? "N/A")</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(item.DichVus != null ? item.DichVus.Count : 0) tour
                                </span>
                            </td>
                            <td>
                                @if (item.TrangThai == "HOAT_DONG")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-door-closed"></i> Đóng cửa</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.MaDiaDiem" class="btn btn-outline-primary" title="Sửa thông tin">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    
                                    <form asp-action="ToggleStatus" asp-route-id="@item.MaDiaDiem" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-warning" title="Đổi trạng thái hoạt động">
                                            <i class="bi bi-power"></i>
                                        </button>
                                    </form>

                                    <form asp-action="Delete" asp-route-id="@item.MaDiaDiem" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa địa điểm này không?');">
                                        <button type="submit" class="btn btn-outline-danger" title="Xóa địa điểm">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i> Không tìm thấy địa điểm nào phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
