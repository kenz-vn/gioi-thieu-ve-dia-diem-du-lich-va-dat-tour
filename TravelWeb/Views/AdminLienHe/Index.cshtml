@model IEnumerable<TravelWeb.Models.LienHe>
@{
    ViewData["Title"] = "Xử Lý Liên Hệ Khách Hàng (DL-22)";
    string currentFilter = ViewBag.TrangThai ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold text-info-emphasis mb-1"><i class="bi bi-envelope-paper"></i> Xử Lý Liên Hệ & Hỗ Trợ Khách Hàng</h2>
        <span class="badge bg-info text-dark">Sprint 4 / Task DL-22: Xử Lý Yêu Cầu Liên Hệ & Ghi Nhận Trạng Thái (Kiên)</span>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- TABS LỌC TRẠNG THÁI LIÊN HỆ -->
<div class="d-flex gap-2 mb-3">
    <a asp-action="Index" class="btn @(string.IsNullOrEmpty(currentFilter) ? "btn-dark" : "btn-outline-dark")">
        Tất cả liên hệ
    </a>
    <a asp-action="Index" asp-route-trangThai="CHUA_XU_LY" class="btn @(currentFilter == "CHUA_XU_LY" ? "btn-warning text-dark fw-bold" : "btn-outline-warning text-dark")">
        <i class="bi bi-clock-history"></i> Chưa xử lý <span class="badge bg-danger ms-1">@ViewBag.CountChuaXuLy</span>
    </a>
    <a asp-action="Index" asp-route-trangThai="DANG_XU_LY" class="btn @(currentFilter == "DANG_XU_LY" ? "btn-info text-dark fw-bold" : "btn-outline-info text-dark")">
        <i class="bi bi-arrow-repeat"></i> Đang xử lý <span class="badge bg-secondary ms-1">@ViewBag.CountDangXuLy</span>
    </a>
    <a asp-action="Index" asp-route-trangThai="DA_XU_LY" class="btn @(currentFilter == "DA_XU_LY" ? "btn-success" : "btn-outline-success")">
        <i class="bi bi-check-all"></i> Đã xử lý xong <span class="badge bg-secondary ms-1">@ViewBag.CountDaXuLy</span>
    </a>
</div>

<!-- BẢNG DANH SÁCH LIÊN HỆ -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Khách Hàng</th>
                    <th>Tiêu Đề / Yêu Cầu</th>
                    <th>Ngày Gửi</th>
                    <th>Trạng Thái</th>
                    <th>Nhân Viên Phụ Trách</th>
                    <th class="text-end">Chi Tiết</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="@(item.TrangThai == "CHUA_XU_LY" ? "table-warning bg-opacity-25" : "")">
                            <td>
                                <div class="fw-bold">@item.HoTen</div>
                                <div class="small text-muted"><i class="bi bi-envelope"></i> @item.Email</div>
                                <div class="small text-muted"><i class="bi bi-telephone"></i> @(item.SoDienThoai ?? "N/A")</div>
                            </td>
                            <td>
                                <div class="fw-semibold text-primary">@item.TieuDe</div>
                                <div class="small text-muted text-truncate" style="max-width: 380px;">@item.NoiDung</div>
                            </td>
                            <td>
                                <div class="small"><i class="bi bi-calendar"></i> @item.NgayGui.ToString("dd/MM/yyyy")</div>
                                <div class="small text-muted">@item.NgayGui.ToString("HH:mm")</div>
                            </td>
                            <td>
                                @if (item.TrangThai == "CHUA_XU_LY")
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> Chưa xử lý</span>
                                }
                                else if (item.TrangThai == "DANG_XU_LY")
                                {
                                    <span class="badge bg-info text-dark"><i class="bi bi-arrow-repeat"></i> Đang xử lý</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Đã phản hồi</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.NguoiXuLy))
                                {
                                    <div class="small fw-semibold"><i class="bi bi-person-check"></i> @item.NguoiXuLy</div>
                                    <div class="small text-muted">@(item.NgayXuLy?.ToString("dd/MM HH:mm") ?? "")</div>
                                }
                                else
                                {
                                    <span class="small text-muted">-- Chưa phân công --</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary fw-bold">
                                    <i class="bi bi-reply"></i> Xem & Xử lý
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i> Không có tin nhắn liên hệ nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
